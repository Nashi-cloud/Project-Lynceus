{
  "manifest_version": 3,
  "name": "__MSG_nom_extension__",
  "version": "0.11.3",
  "default_locale": "fr",
  "description": "__MSG_description_extension__",
  "minimum_chrome_version": "116",
  "permissions": [
    "sidePanel",
    "contextMenus",
    "activeTab",
    "storage",
    "scripting"
  ],
  "optional_permissions": [
    "tabs"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "fond.js"
  },
  "action": {
    "default_title": "__MSG_action_titre__",
    "default_icon": {
      "16": "icones/lynceus-16.png",
      "32": "icones/lynceus-32.png",
      "48": "icones/lynceus-48.png",
      "128": "icones/lynceus-128.png"
    }
  },
  "side_panel": {
    "default_path": "panneau/panneau.html"
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "icons": {
    "16": "icones/lynceus-16.png",
    "32": "icones/lynceus-32.png",
    "48": "icones/lynceus-48.png",
    "128": "icones/lynceus-128.png"
  }
}
