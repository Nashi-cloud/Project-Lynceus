# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Node / extension
node_modules/
dist/
*.tsbuildinfo
lynceus-extension-v*.zip

# Environnement & secrets
.env
.env.*
!.env.example
!.env.prod.example
!.env.portail.example

# IDE / OS
.idea/
.vscode/
.DS_Store

# Données locales
*.sqlite3
postgres-data/

# Paquets d'extension déposés pour le portail : artefacts de build, jamais versionnés.
api/paquets/*
!api/paquets/.gitkeep

# Captures de pages réelles : non versionnées (droit d'auteur).
# Seul le manifeste corpus/corpus.yaml l'est ; recréez-les avec `lynceus capturer`.
corpus/captures/*.md
