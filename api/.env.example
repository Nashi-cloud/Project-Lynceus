# Copier ce fichier vers .env puis compléter.

# --- Fournisseur LLM (tout endpoint compatible OpenAI) ---
LYNCEUS_LLM_API_KEY=sk-or-xxxxxxxxxxxx
LYNCEUS_LLM_BASE_URL=https://openrouter.ai/api/v1
LYNCEUS_LLM_MODEL=anthropic/claude-sonnet-5

# Nom du fournisseur tel qu'il sera PUBLIÉ : dans /v1/meta, dans chaque analyse de
# l'annuaire, et sur la page de confidentialité du portail. Vide = déduit de l'adresse
# ci-dessus, ce qui donne le nom d'hôte. Deux cas où c'est insuffisant : un routeur
# d'inférence n'est pas celui qui exécute le modèle, et le nom d'hôte d'un modèle
# auto-hébergé n'a pas à être publié (l'adresse privée est alors annoncée comme
# « modèle auto-hébergé », sans nommer la machine).
LYNCEUS_LLM_FOURNISSEUR=
LYNCEUS_LLM_TIMEOUT_S=180
# Filet de sécurité (secondes) : au-delà, l'appel au fournisseur LLM est abandonné.
# Le serveur retente 1 fois en cas de sortie invalide : 360 s au pire par analyse.
# Cache de prompt. Le prompt système fait ~3 500 tokens (taxonomie et schéma) et part
# identique à chaque analyse, quand une page en pèse quelques centaines : c'est lui qui
# domine la facture d'entrée. Marqué comme réutilisable, il est facturé au tarif de
# relecture dès le deuxième appel, environ cinq fois moins cher.
# À ACTIVER sur une instance qui parle à un fournisseur distant. À laisser à false devant
# un endpoint auto-hébergé minimal, qui peut refuser un contenu découpé en blocs.
#LYNCEUS_LLM_CACHE_PROMPT=true

# Raisonnement du modèle. Ce qu'il « pense » avant de répondre est facturé comme de la
# sortie puis jeté : mesuré à 2 331 tokens pour une carte qui en fait moins de 1 500, soit
# le premier poste de dépense, loin devant le prompt système.
# Vide = défaut du fournisseur · non = désactivé · faible / moyen / eleve = ampleur réglée.
# À ne changer qu'avec une passe de calibration à l'appui : sur une passe unique, couper le
# raisonnement divise le coût par 2,8 et la latence par 2, mais coûte un cas conforme.
#LYNCEUS_LLM_RAISONNEMENT=non

# Ollama en local (gratuit, auto-hébergé) :
#LYNCEUS_LLM_BASE_URL=http://localhost:11434/v1
#LYNCEUS_LLM_MODEL=llama3.1
#LYNCEUS_LLM_API_KEY=ollama

# --- Base de données ---
# Défaut : SQLite local (zéro config, parfait pour essayer)
LYNCEUS_DATABASE_URL=sqlite:///./lynceus.sqlite3
# PostgreSQL (recommandé en production) :
#LYNCEUS_DATABASE_URL=postgresql+psycopg://lynceus:lynceus@localhost:5432/lynceus

# --- Modération des contestations ---
# Sans jeton, les routes /v1/admin/* restent FERMÉES : les contestations peuvent contenir
# un contact, elles ne doivent pas être exposées publiquement par simple oubli de configuration.
# Générer : python3 -c "import secrets; print(secrets.token_urlsafe(32))"
#LYNCEUS_ADMIN_TOKEN=

# --- Clés d'accès (facultatif) ---
# Vide = instance OUVERTE, aucune clé exigée : c'est le défaut, adapté à un usage personnel
# ou auto-hébergé. Renseigner la clé publique de l'émetteur ferme les analyses aux seuls
# porteurs d'une clé valide (les consultations d'annuaire restent libres).
#
#   lynceus cles-paire                          -> génère la paire (privée / publique)
#   LYNCEUS_CLE_PRIVEE=… lynceus cle-emettre    -> émet une clé (chez l'émetteur uniquement)
#
# La clé PRIVÉE ne va JAMAIS ici ni dans l'extension : elle seule permet d'émettre.
#LYNCEUS_CLE_PUBLIQUE=
# Identifiants de clés révoquées, séparés par des virgules (liste noire, pas un annuaire).
#LYNCEUS_CLES_REVOQUEES=
