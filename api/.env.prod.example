# Configuration d'une instance Lynceus exposée.
# Copier en .env à côté de docker-compose.prod.yml, puis compléter.
# Ce fichier contient des secrets : ne JAMAIS le versionner.

# --- Base de données ---
# python3 -c "import secrets; print(secrets.token_urlsafe(24))"
POSTGRES_PASSWORD=

# --- Modèle d'analyse ---
LYNCEUS_LLM_API_KEY=
LYNCEUS_LLM_BASE_URL=https://openrouter.ai/api/v1
LYNCEUS_LLM_MODEL=z-ai/glm-5.2

# Nom du fournisseur tel qu'il sera PUBLIÉ : dans /v1/meta, dans chaque analyse de
# l'annuaire, et sur la page de confidentialité du portail. Vide = déduit de l'adresse
# ci-dessus, ce qui donne le nom d'hôte. Deux cas où c'est insuffisant : un routeur
# d'inférence n'est pas celui qui exécute le modèle, et le nom d'hôte d'un modèle
# auto-hébergé n'a pas à être publié (l'adresse privée est alors annoncée comme
# « modèle auto-hébergé », sans nommer la machine).
LYNCEUS_LLM_FOURNISSEUR=

# --- Accès (obligatoire pour une instance exposée) ---
# Générer la paire avec : lynceus cles-paire
# La clé PRIVÉE ne va PAS ici : elle reste chez l'émetteur, seul habilité à créer des clés.
LYNCEUS_CLE_PUBLIQUE=
# Identifiants de clés révoquées, séparés par des virgules.
LYNCEUS_CLES_REVOQUEES=

# --- Modération ---
# python3 -c "import secrets; print(secrets.token_urlsafe(32))"
LYNCEUS_ADMIN_TOKEN=

# --- Garde-fous ---
LYNCEUS_RATE_LIMIT_ANALYSES=10
# Analyses menées de front. Au-delà, les demandes patientent (elles aboutissent, plus tard)
# sans bloquer les consultations d'annuaire. Augmentez si votre fournisseur de modèle suit.
LYNCEUS_ANALYSES_SIMULTANEES=12

# Connexions à la base. Dimensionné sur les threads du serveur : trop peu ferait attendre
# des requêtes pour une connexion libre, sans que la base soit en cause.
LYNCEUS_BDD_POOL_SIZE=20
LYNCEUS_BDD_MAX_OVERFLOW=20
LYNCEUS_CONTENU_MAX_CARS=60000

# --- Exposition par Cloudflare Tunnel ---
# Jeton fourni par Cloudflare Zero Trust -> Networks -> Tunnels.
# Le hostname public doit pointer vers http://api:8000 (nom du service Docker).
# Démarrage : docker compose -f docker-compose.prod.yml --profile tunnel up -d
CLOUDFLARE_TUNNEL_TOKEN=

# Active le service de tunnel, qui vit derrière un profil Compose et n'existe donc pas
# tant qu'on ne le nomme pas. En ligne de commande, le drapeau « --profile tunnel » fait
# la même chose ; depuis Portainer, où il n'y a pas de drapeau à passer, c'est cette
# variable qui l'active. Laissez-la vide si vous exposez autrement (Tailscale, nginx).
COMPOSE_PROFILES=tunnel

# En-tête portant l'adresse réelle du visiteur. À définir UNIQUEMENT si l'instance n'est
# joignable que par le tunnel : un en-tête se falsifie, et une instance accessible en
# direct verrait sa limite de débit contournée.
#   Cloudflare : CF-Connecting-IP   ·   nginx : X-Real-IP
LYNCEUS_ENTETE_IP_REELLE=

# --- Image et exposition ---
# Registre d'où tirer l'image. À remplacer par le vôtre.
# Image publique du projet. Épingler une version (…:v0.11.2) rend le retour arrière
# trivial. Si vous modifiez le code, publiez la vôtre : l'AGPL-3.0 vous y oblige dès
# que votre service est accessible à distance.
LYNCEUS_IMAGE=ghcr.io/nashi-cloud/lynceus-api:latest
# Adresse d'écoute. 127.0.0.1 si Tailscale Serve tourne sur la même machine (recommandé),
# l'adresse Tailscale de l'hôte s'il faut y accéder depuis le tailnet.
LYNCEUS_BIND=127.0.0.1
# Suffixe ajouté au nom des conteneurs, pour que deux environnements cohabitent sur une
# même machine sans se disputer « lynceus-api ». Vide en production, « -staging » ailleurs.
LYNCEUS_SUFFIXE=
