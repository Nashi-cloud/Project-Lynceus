# Configuration du portail public Lynceus (le site).
# Copier en .env à côté de docker-compose.portail.yml, puis compléter.
# Ce fichier contient LA clé la plus sensible du projet : ne JAMAIS le versionner.

# --- Identité ---
LYNCEUS_PORTAIL_NOM=Lynceus
# Affiché sur la page « contester » et dans le pied de page. Vide = aucun contact publié.
LYNCEUS_PORTAIL_CONTACT=

# --- Émission de clés ---
# Clé PRIVÉE Ed25519, produite par : lynceus cles-paire
# C'est elle qui signe les clés d'accès. Elle ne doit se trouver NULLE PART ailleurs :
# ni sur l'instance, ni dans l'extension, ni dans le dépôt. Quiconque l'obtient peut
# émettre des clés à volonté sur votre instance, donc dépenser votre budget de modèle.
# Laisser vide fait du portail une simple vitrine : les pages restent servies, et
# l'inscription répond en expliquant qu'aucune clé n'est délivrée ici.
LYNCEUS_PORTAIL_CLE_PRIVEE=

# Adresse PUBLIQUE de l'instance, annoncée aux extensions qui s'inscrivent.
# Elle doit être joignable depuis le navigateur des visiteurs.
LYNCEUS_PORTAIL_INSTANCE=https://api.exemple.fr
# Adresse par laquelle le portail interroge lui-même l'instance (annuaire, contestations).
# Vide = identique à la précédente. À renseigner si les deux services partagent un réseau
# interne (http://api:8000) : les requêtes du portail évitent alors le tour par Internet.
LYNCEUS_PORTAIL_INSTANCE_INTERNE=

# Droits portés par chaque clé délivrée.
LYNCEUS_PORTAIL_QUOTA_JOUR=20
LYNCEUS_PORTAIL_VALIDITE_JOURS=365

# Clés délivrées par adresse et par jour. 0 = inscription libre (défaut assumé).
# À relever si l'inscription ouverte attire des scripts : chaque clé donne droit à des
# analyses facturées, et rien n'empêche un script d'en demander mille.
LYNCEUS_PORTAIL_CLES_PAR_IP_JOUR=0

# --- Distribution de l'extension ---
# Dossiers d'archives, séparés par des virgules, la version la plus haute l'emportant.
# Le défaut convient : le volume ./paquets d'abord, puis le paquet embarqué dans l'image.
LYNCEUS_PORTAIL_PAQUETS=/paquets,/app/paquets-image

# Adresse publique de CE portail. Elle est inscrite dans l'archive au téléchargement, si
# bien que l'extension sait à qui demander sa clé sans que personne ait à la recopier.
# Vide = déduite de la requête. À renseigner derrière un proxy ou un tunnel, faute de quoi
# l'adresse inscrite pourrait être en http alors que le site est servi en https.
LYNCEUS_PORTAIL_ADRESSE=https://lynceus.exemple.fr

# --- Exposition par Cloudflare Tunnel ---
# Le hostname public doit pointer vers http://portail:8080 (nom du service Docker).
# Démarrage : docker compose -f docker-compose.portail.yml --profile tunnel up -d
CLOUDFLARE_TUNNEL_TOKEN=

# En-tête portant l'adresse réelle du visiteur. À définir UNIQUEMENT si le portail n'est
# joignable que par le tunnel — un en-tête se falsifie.
LYNCEUS_PORTAIL_ENTETE_IP_REELLE=

# --- Image et exposition ---
LYNCEUS_IMAGE=votre-registre.exemple/lynceus-api:latest
LYNCEUS_PORTAIL_BIND=127.0.0.1
