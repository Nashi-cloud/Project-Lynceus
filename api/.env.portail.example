# Configuration du portail public Lynceus (le site).
# Copier en .env à côté de docker-compose.portail.yml, puis compléter.
# Ce fichier contient LA clé la plus sensible du projet : ne JAMAIS le versionner.

# --- Identité ---
LYNCEUS_PORTAIL_NOM=Lynceus
# Affiché sur la page « contester » et dans le pied de page. Vide = aucun contact publié.
LYNCEUS_PORTAIL_CONTACT=

# --- Code source ---
# L'AGPL-3.0 impose (article 13) de proposer le code correspondant, modifications
# comprises, aux personnes qui utilisent le service à distance. Si vous avez modifié
# Lynceus, c'est VOTRE version qu'il faut publier, pas celle d'origine.
# Vide = les pages parlent du dépôt sans pouvoir y renvoyer, et le portail avertit au
# démarrage. Les liens du pied de page et des documents s'appuient dessus.
LYNCEUS_PORTAIL_DEPOT=https://github.com/Nashi-cloud/Project-Lynceus
# Préfixe désignant un fichier précis du dépôt, branche comprise. Chaque forge a sa
# forme : <dépôt>/blob/main sur GitHub et GitLab, <dépôt>/src/branch/main sur Forgejo.
# Vide = les chemins cités dans les documents s'affichent sans lien.
LYNCEUS_PORTAIL_DEPOT_FICHIERS=https://github.com/Nashi-cloud/Project-Lynceus/blob/main

# --- Émission de clés ---
# Clé PRIVÉE Ed25519, produite par : lynceus cles-paire
# C'est elle qui signe les clés d'accès. Elle ne doit se trouver NULLE PART ailleurs :
# ni sur l'instance, ni dans l'extension, ni dans le dépôt. Quiconque l'obtient peut
# émettre des clés à volonté sur votre instance, donc dépenser votre budget de modèle.
# Laisser vide fait du portail une simple vitrine : les pages restent servies, et
# l'inscription répond en expliquant qu'aucune clé n'est délivrée ici.
LYNCEUS_PORTAIL_CLE_PRIVEE=

# Adresse PUBLIQUE de l'instance, annoncée aux extensions qui s'inscrivent.
# Elle doit être joignable depuis le navigateur des visiteurs.
LYNCEUS_PORTAIL_INSTANCE=https://api.exemple.fr
# Adresse par laquelle le portail interroge lui-même l'instance (annuaire, contestations).
# Vide = identique à la précédente. À renseigner si les deux services partagent un réseau
# interne (http://api:8000) : les requêtes du portail évitent alors le tour par Internet.
LYNCEUS_PORTAIL_INSTANCE_INTERNE=

# Droits portés par chaque clé délivrée.
LYNCEUS_PORTAIL_QUOTA_JOUR=20
LYNCEUS_PORTAIL_VALIDITE_JOURS=365

# Clés délivrées par adresse et par jour. 0 = inscription libre (défaut assumé).
# À relever si l'inscription ouverte attire des scripts : chaque clé donne droit à des
# analyses facturées, et rien n'empêche un script d'en demander mille.
LYNCEUS_PORTAIL_CLES_PAR_IP_JOUR=0

# --- Identité légale de l'exploitant ---
# OBLIGATOIRE dès que le portail est ouvert au public : la loi impose d'identifier
# l'éditeur d'un service de communication au public en ligne. Ces champs alimentent les
# pages /mentions-legales, /confidentialite et /conditions. Non renseignés, ces pages
# indiquent honnêtement qu'elles ne le sont pas, et le portail avertit au démarrage.
# Un usage strictement personnel n'a pas à les remplir.
# Valeurs d'exemple à REMPLACER par les vôtres. Les laisser telles quelles publierait
# l'identité de quelqu'un d'autre sur votre instance, ce qui serait à la fois faux et
# inutile : c'est vous qui êtes responsable de ce que votre instance publie.
LYNCEUS_PORTAIL_EDITEUR_NOM=Votre nom ou raison sociale
LYNCEUS_PORTAIL_EDITEUR_STATUT=association loi 1901, SAS, entrepreneur individuel…
LYNCEUS_PORTAIL_EDITEUR_ADRESSE=1 rue de l'Exemple, 75000 Ville, France
LYNCEUS_PORTAIL_EDITEUR_IDENTIFIANT=SIREN 000 000 000
LYNCEUS_PORTAIL_EDITEUR_DIRECTEUR=Nom du directeur de la publication
LYNCEUS_PORTAIL_EDITEUR_CONTACT=contact@exemple.fr

LYNCEUS_PORTAIL_HEBERGEUR_NOM=Nom de votre hébergeur
LYNCEUS_PORTAIL_HEBERGEUR_ADRESSE=Adresse de votre hébergeur
LYNCEUS_PORTAIL_HEBERGEUR_SITE=https://exemple-hebergeur.fr

LYNCEUS_PORTAIL_DROIT_APPLICABLE=français

# --- Distribution de l'extension ---
# Dossiers d'archives, séparés par des virgules, la version la plus haute l'emportant.
# Le défaut convient : le volume ./paquets d'abord, puis le paquet embarqué dans l'image.
LYNCEUS_PORTAIL_PAQUETS=/paquets,/app/paquets-image

# Dossier de l'hôte monté sur /paquets. Chemin ABSOLU : un chemin relatif se résoudrait
# par rapport au répertoire d'où Compose est lancé, ce qui ne veut plus rien dire quand
# c'est Portainer qui déploie la stack.
LYNCEUS_PAQUETS=/opt/lynceus/paquets

# Adresse publique de CE portail. Elle est inscrite dans l'archive au téléchargement, si
# bien que l'extension sait à qui demander sa clé sans que personne ait à la recopier.
# Vide = déduite de la requête. À renseigner derrière un proxy ou un tunnel, faute de quoi
# l'adresse inscrite pourrait être en http alors que le site est servi en https.
LYNCEUS_PORTAIL_ADRESSE=https://lynceus.exemple.fr

# --- Exposition par Cloudflare Tunnel ---
# Le hostname public doit pointer vers http://portail:8080 (nom du service Docker).
# Démarrage : docker compose -f docker-compose.portail.yml --profile tunnel up -d
CLOUDFLARE_TUNNEL_TOKEN=

# Active le service de tunnel, qui vit derrière un profil Compose et n'existe donc pas
# tant qu'on ne le nomme pas. En ligne de commande, le drapeau « --profile tunnel » fait
# la même chose ; depuis Portainer, où il n'y a pas de drapeau à passer, c'est cette
# variable qui l'active. Laissez-la vide si vous exposez autrement (Tailscale, nginx).
COMPOSE_PROFILES=tunnel

# En-tête portant l'adresse réelle du visiteur. À définir UNIQUEMENT si le portail n'est
# joignable que par le tunnel — un en-tête se falsifie.
LYNCEUS_PORTAIL_ENTETE_IP_REELLE=

# --- Image et exposition ---
# Registre d'où tirer l'image. À remplacer par le vôtre.
# Image publique du projet. Épingler une version (…:v0.11.2) rend le retour arrière
# trivial. Si vous modifiez le code, publiez la vôtre : l'AGPL-3.0 vous y oblige dès
# que votre service est accessible à distance.
LYNCEUS_IMAGE=ghcr.io/nashi-cloud/lynceus-api:latest
LYNCEUS_PORTAIL_BIND=127.0.0.1
# Suffixe ajouté au nom des conteneurs, pour que deux environnements cohabitent sur une
# même machine sans se disputer « lynceus-portail ». Vide en production.
LYNCEUS_SUFFIXE=
